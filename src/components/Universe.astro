---
import { ArrowRight, ChartNoAxesCombined, CircuitBoard, Cog, ScanSearch } from "@lucide/astro";
const projects = [
  { href:"/projects/lung-cancer-lm-prediction", index:"01", type:"MEDICAL AI", title:"肺癌脑膜转移预测", en:"MRI-based LM Prediction", desc:"融合 MRI 影像、Transformer 与可解释 AI 的临床预测系统。", tags:["MRI","Transformer","Multimodal"], Icon:ScanSearch, tone:"acid" },
  { href:"/projects/lstm-aero-engine-rul", index:"02", type:"DEEP LEARNING", title:"航空发动机剩余寿命预测", en:"Aero-engine RUL Prediction", desc:"基于 NASA C-MAPSS 数据集的时序退化建模与寿命预测。", tags:["LSTM","Attention","Time Series"], Icon:ChartNoAxesCombined, tone:"cyan" },
  { href:"/projects/gearbox-design", index:"03", type:"MECHANICAL DESIGN", title:"减速箱系统设计", en:"Gearbox System Design", desc:"从参数计算、结构设计到工程图与装配动画的完整工程闭环。", tags:["SolidWorks","CAD","Mechanics"], Icon:Cog, tone:"orange" },
  { href:"/projects/electronic-circuit", index:"04", type:"FPGA & ROBOTICS", title:"FPGA 语音机器人控制", en:"FPGA Voice Robot Control", desc:"从语音感知、身份验证到闭环运动控制与 Web 数字孪生。", tags:["Verilog","FPGA","Digital Twin"], Icon:CircuitBoard, tone:"cyan" },
  { href:"/research", index:"05", type:"PROJECT INDEX", title:"浏览全部", en:"Explore all projects", desc:"8 个项目 · 3 个方向", tags:[], Icon:null, tone:"muted" },
];
---
<section class="work section-shell" id="selected-work">
  <div class="section-heading" data-reveal>
    <div><span class="eyebrow">SELECTED WORK</span><h2>最近在做的几件事。</h2></div>
    <p>这里放着我目前最想介绍的项目。每一项都有完整的背景、过程和结果，也记录了中间遇到的问题。</p>
  </div>
  <div class="project-grid">
    {projects.map(({href,index,type,title,en,desc,tags,Icon,tone}, i) => i === projects.length - 1 ? (
      <a href={href} class="project-card browse-all muted" data-reveal>
        <span class="browse-plus" aria-hidden="true">＋</span>
        <div><span class="browse-index">{index} / {type}</span><h3>{title}</h3><p>{en}</p><small>{desc}</small></div>
        <ArrowRight size={22} />
      </a>
    ) : (
      <a href={href} class:list={["project-card",tone]} data-reveal>
        <div class="card-top"><span>{index} / {type}</span>{Icon && <Icon size={22} strokeWidth={1.5} />}</div>
        <div class="card-copy"><h3>{title}</h3><p class="project-en">{en}</p><p>{desc}</p></div>
        <div class="card-bottom"><div>{tags.map(tag => <span>{tag}</span>)}</div><ArrowRight size={20} /></div>
      </a>
    ))}
  </div>
</section>

<style>
  .work{padding-top:110px;padding-bottom:120px}.project-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.project-card{position:relative;min-height:390px;padding:26px;display:flex;flex-direction:column;justify-content:space-between;border:1px solid var(--line);border-radius:18px;background:rgba(16,30,26,.72);color:var(--ink);text-decoration:none;overflow:hidden;transition:.35s var(--ease)}.project-card::before{content:"";position:absolute;width:220px;height:220px;right:-100px;top:-100px;border:1px solid currentColor;border-radius:50%;opacity:.08;transition:.4s var(--ease)}.project-card:hover{transform:translateY(-7px);border-color:currentColor}.project-card:hover::before{transform:scale(1.25)}.project-card.acid{color:var(--acid)}.project-card.cyan{color:var(--cyan)}.project-card.orange{color:var(--orange)}.project-card.muted{color:#c2ccc6}.card-top{display:flex;justify-content:space-between;align-items:center;color:currentColor}.card-top>span{font:600 10px/1 var(--mono);letter-spacing:.12em}.card-copy{margin-top:70px;color:var(--ink)}.card-copy h3{max-width:580px;margin:0;font:720 clamp(29px,4vw,54px)/1.04 var(--display);letter-spacing:-.045em}.project-en{margin:8px 0 20px!important;color:currentColor!important;font:500 12px/1.3 var(--mono)!important;text-transform:uppercase}.card-copy>p:last-child{max-width:560px;color:var(--muted);font-size:15px}.card-bottom{display:flex;align-items:end;justify-content:space-between;gap:20px;color:currentColor}.card-bottom>div{display:flex;gap:7px;flex-wrap:wrap}.card-bottom span{padding:6px 8px;border:1px solid var(--line);border-radius:7px;color:var(--muted);font:500 10px/1 var(--mono)}.project-card:hover .card-bottom>svg{transform:translateX(5px)}.card-bottom>svg{transition:.25s var(--ease)}
  @media(min-width:980px){.project-card.wide{grid-column:span 2;min-height:440px}.project-card.wide .card-copy h3{font-size:68px}}
  @media(max-width:700px){.work{padding-top:72px;padding-bottom:80px}.project-grid{grid-template-columns:1fr}.project-card{min-height:345px;padding:22px}.card-copy{margin-top:48px}}
  .work{padding-top:96px;padding-bottom:110px}.project-card{min-height:300px;padding:22px;border-radius:16px}.project-card::before{width:150px;height:150px;right:-65px;top:-65px}.project-card:hover{transform:translateY(-5px)}.card-top>span{font-size:9px}.card-copy{margin-top:38px}.card-copy h3{font-size:clamp(28px,3vw,42px);line-height:1.08}.project-en{margin:6px 0 14px!important;font-size:10px!important}.card-copy>p:last-child{margin-bottom:18px;font-size:14px;line-height:1.65}.card-bottom{gap:16px}.card-bottom span{padding:5px 7px;border-radius:6px;font-size:9px}
  @media(min-width:980px){.project-card.wide{grid-column:span 1;min-height:300px}.project-card.wide .card-copy h3{font-size:clamp(30px,3vw,42px)}}
  @media(max-width:700px){.project-card{min-height:285px;padding:20px}.card-copy{margin-top:32px}}
  .project-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
  .project-card,.project-card.wide{min-height:330px;padding:20px;background:rgba(255,255,255,.045);color:var(--acid)}
  .project-card::before{display:none}.card-copy{margin-top:38px}.card-copy h3{font-size:clamp(25px,2.25vw,34px);line-height:1.08}.card-copy>p:last-child{font-size:13px;line-height:1.65}.card-bottom span{font-size:8px}
  .browse-all{display:grid;grid-template-rows:1fr auto;align-items:end;border-style:dashed;background:rgba(255,255,255,.018);opacity:.66;filter:saturate(.45);transition:opacity .3s var(--ease),transform .3s var(--ease),border-color .3s var(--ease)}
  .browse-all:hover{opacity:1;filter:none}.browse-plus{align-self:start;font:300 64px/1 var(--display);color:var(--acid)}.browse-all>div{align-self:end}.browse-index{font:600 9px var(--mono);letter-spacing:.12em;color:var(--muted)}.browse-all h3{margin:18px 0 2px;font:720 clamp(27px,2.4vw,36px)/1 var(--display);letter-spacing:-.045em}.browse-all p{margin:7px 0;color:var(--muted);font:500 10px var(--mono);text-transform:uppercase}.browse-all small{color:var(--muted);font-size:12px}.browse-all>svg{position:absolute;right:20px;bottom:20px;color:var(--acid)}
  @media(max-width:820px){.project-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.project-card,.project-card.wide{min-height:300px}}
  @media(max-width:700px){.project-grid{grid-template-columns:1fr}.project-card,.project-card.wide{min-height:280px}}
</style>
