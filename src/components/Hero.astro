---
import { ArrowDown, ArrowUpRight } from "@lucide/astro";
---
<section class="hero">
  <div class="hero-grid section-shell">
    <div class="hero-copy">
      <div class="availability"><span></span> 同济大学 · 智能制造工程</div>
      <p class="kicker">RESEARCHER / BUILDER / EXPLORER</p>
      <h1><span>先把问题</span><br /><span class="accent">想清楚</span>，再动手。</h1>
      <p class="lead">我是 Yoyo，在同济读智能制造。我现在主要做医学影像 AI、深度学习和机械设计，也会把这里当作自己的项目档案。</p>
      <div class="hero-actions">
        <a class="button-primary" href="/research">看看我的项目 <ArrowUpRight size={18} /></a>
        <a class="button-secondary" href="/resume">阅读个人简历</a>
      </div>
    </div>

    <aside class="signal-panel" aria-label="研究方向概览">
      <div class="panel-head"><span>RESEARCH SIGNAL</span><span class="pulse">LIVE</span></div>
      <div class="orbit" aria-hidden="true">
        <div class="orbit-ring ring-one"></div><div class="orbit-ring ring-two"></div>
        <span class="node n1">MRI</span><span class="node n2">AI</span><span class="node n3">ME</span>
        <div class="orbit-core">Y</div>
      </div>
      <dl class="signal-list">
        <div><dt>01</dt><dd>Medical Imaging AI</dd><span>医学影像</span></div>
        <div><dt>02</dt><dd>Deep Learning</dd><span>深度学习</span></div>
        <div><dt>03</dt><dd>Intelligent Mechanics</dd><span>智能机械</span></div>
      </dl>
    </aside>
  </div>
  <a class="scroll-cue" href="#selected-work"><span>SCROLL TO EXPLORE</span><ArrowDown size={16} /></a>
</section>

<style>
  .hero{position:relative;min-height:100svh;padding:138px 0 76px;display:flex;align-items:center;overflow:hidden}.hero::before{content:"";position:absolute;width:52vw;aspect-ratio:1;right:-18vw;top:-10vw;border:1px solid rgba(201,255,95,.1);border-radius:50%;box-shadow:0 0 0 9vw rgba(117,230,208,.018),0 0 0 18vw rgba(201,255,95,.012);animation:breathe 8s ease-in-out infinite}.hero-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(340px,.65fr);gap:clamp(40px,7vw,100px);align-items:center}.hero-copy{position:relative;z-index:2}.availability{display:inline-flex;align-items:center;gap:9px;margin-bottom:42px;padding:8px 11px;border:1px solid var(--line);border-radius:999px;color:var(--muted);font:500 11px/1 var(--mono)}.availability span{width:7px;height:7px;background:var(--acid);border-radius:50%;box-shadow:0 0 14px var(--acid);animation:pulse 2s ease-out infinite}.kicker{margin:0 0 18px;color:var(--cyan);font:600 11px/1.3 var(--mono);letter-spacing:.18em}.hero h1{margin:0;max-width:850px;font:780 clamp(54px,8vw,118px)/.88 var(--display);letter-spacing:-.075em}.hero h1>span:first-child{color:var(--ink)}.hero h1 .accent{position:relative;color:var(--acid);white-space:nowrap}.hero h1 .accent::after{content:"";position:absolute;left:1%;right:0;bottom:.02em;height:.06em;background:currentColor;transform:scaleX(.15);transform-origin:left;animation:draw 1.1s .5s var(--ease) forwards}.lead{max-width:680px;margin:32px 0 0;color:var(--muted);font-size:clamp(17px,2vw,21px);line-height:1.72}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:34px}.signal-panel{position:relative;padding:20px;border:1px solid var(--line);border-radius:22px;background:linear-gradient(145deg,rgba(16,30,26,.92),rgba(10,23,19,.72));box-shadow:0 30px 90px rgba(0,0,0,.25);overflow:hidden}.panel-head{display:flex;justify-content:space-between;font:600 10px/1 var(--mono);letter-spacing:.12em;color:var(--muted)}.panel-head .pulse{color:var(--acid)}.orbit{position:relative;display:grid;place-items:center;width:min(100%,330px);aspect-ratio:1;margin:18px auto}.orbit::before{content:"";position:absolute;inset:6%;border-radius:50%;background:radial-gradient(circle,rgba(117,230,208,.08),transparent 60%)}.orbit-ring{position:absolute;border:1px solid rgba(201,255,95,.2);border-radius:50%;animation:spin 16s linear infinite}.ring-one{inset:16%;border-style:dashed}.ring-two{inset:30%;animation-direction:reverse;animation-duration:10s}.orbit-core{position:relative;z-index:2;display:grid;place-items:center;width:74px;height:74px;border-radius:50%;background:var(--acid);color:var(--bg);font:800 31px/1 var(--display);box-shadow:0 0 35px rgba(201,255,95,.2)}.node{position:absolute;z-index:2;display:grid;place-items:center;width:42px;height:42px;border:1px solid var(--line);border-radius:50%;background:var(--panel);color:var(--cyan);font:600 10px/1 var(--mono)}.n1{left:5%;top:48%}.n2{right:12%;top:16%}.n3{right:5%;bottom:15%}.signal-list{margin:0}.signal-list div{display:grid;grid-template-columns:30px 1fr auto;align-items:center;gap:8px;padding:12px 0;border-top:1px solid var(--line)}.signal-list dt{color:var(--acid);font:600 10px var(--mono)}.signal-list dd{margin:0;font-size:13px}.signal-list span{color:var(--muted);font-size:12px}.scroll-cue{position:absolute;bottom:28px;left:clamp(24px,5vw,72px);display:flex;align-items:center;gap:9px;color:var(--muted);text-decoration:none;font:500 9px/1 var(--mono);letter-spacing:.14em}.scroll-cue:hover{color:var(--acid)}
  @keyframes spin{to{transform:rotate(1turn)}}@keyframes pulse{50%{box-shadow:0 0 0 7px rgba(201,255,95,0)}}@keyframes draw{to{transform:scaleX(1)}}@keyframes breathe{50%{transform:scale(1.05)}}
  @media(max-width:960px){.hero{padding-top:115px;align-items:flex-start}.hero-grid{grid-template-columns:1fr}.signal-panel{max-width:540px}.scroll-cue{display:none}}
  @media(max-width:560px){.hero{padding-bottom:56px}.availability{margin-bottom:28px}.hero h1{font-size:clamp(50px,17vw,76px)}.lead{font-size:16px}.signal-panel{padding:16px}.orbit{width:260px}.signal-list div{grid-template-columns:28px 1fr}.signal-list span{display:none}}
  .hero h1{font-size:clamp(52px,6vw,88px);line-height:.98;letter-spacing:-.06em}.hero h1 .accent{display:inline-block}.hero h1 .accent::after{bottom:-.02em;height:.055em}
  @media(max-width:560px){.hero h1{font-size:clamp(48px,14vw,68px);line-height:1.02}}
</style>
