---
export interface Props {
  type: "line" | "bar";
  labels: string[];
  data: number[];
  label: string;
  color: string;
}

const { type, labels, data, label, color } = Astro.props;
const chartId = `chart-${Math.random().toString(36).slice(2, 9)}`;
const labelsJson = JSON.stringify(labels);
const dataJson = JSON.stringify(data);
---

<div class="chart-wrapper">
  <canvas id={chartId}></canvas>
</div>

<script define:vars={{ chartId, type, labels: labelsJson, data: dataJson, label, color }}>
  import Chart from "chart.js/auto";

  const labelColors = {
    pink: { border: "#FF9BC5", background: "rgba(255,155,197,0.2)" },
    blue: { border: "#91BAFF", background: "rgba(145,186,255,0.2)" },
    green: { border: "#A1FFB0", background: "rgba(161,255,176,0.2)" },
    purple: { border: "#E8D9FF", background: "rgba(232,217,255,0.3)" },
  };

  const key = Object.keys(labelColors).find((k) => color.toLowerCase().includes(k));
  const c = key ? labelColors[key] : { border: color, background: color + "33" };

  new Chart(document.getElementById(chartId), {
    type: type,
    data: {
      labels: JSON.parse(labels),
      datasets: [{
        label: label,
        data: JSON.parse(data),
        borderColor: c.border,
        backgroundColor: c.background,
        borderWidth: 3,
        tension: 0.35,
        fill: type === "line",
        borderRadius: type === "bar" ? 8 : 0,
      }],
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: "rgba(0,0,0,0.8)",
          padding: 12,
          borderRadius: 8,
          titleFont: { size: 14, weight: "600" },
          bodyFont: { size: 13 },
        },
      },
      scales: {
        x: {
          grid: { display: false },
          ticks: { color: "#999", font: { size: 12 } },
        },
        y: {
          grid: { color: "rgba(0,0,0,0.05)" },
          ticks: { color: "#999", font: { size: 12 } },
          beginAtZero: true,
        },
      },
    },
  });
</script>

<style>
  .chart-wrapper {
    position: relative;
    width: 100%;
    height: 260px;
  }
</style>
