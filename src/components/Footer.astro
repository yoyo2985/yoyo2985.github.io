---
import { ArrowUpRight } from "@lucide/astro";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div><span class="eyebrow">LET'S CONNECT</span><h2>让研究继续发生。</h2></div>
  <div class="footer-links">
    <a href="/assistant">AI 导览 <ArrowUpRight size={16} /></a>
    <a href="https://github.com/yoyo2985" target="_blank" rel="noopener">GitHub <ArrowUpRight size={16} /></a>
    <a href="/resume/Yoyo_CV.pdf" target="_blank">PDF 简历 <ArrowUpRight size={16} /></a>
  </div>
  <p>© {year} Yoyo · Built with curiosity and Astro.</p>
</footer>
<style>
  .site-footer{position:relative;display:grid;grid-template-columns:1fr auto;gap:30px;align-items:end;margin:0 auto;padding:80px max(5vw,24px) 32px;max-width:1500px;border-top:1px solid var(--line)}.site-footer h2{margin:10px 0 0;font:700 clamp(30px,5vw,68px)/.98 var(--display);letter-spacing:-.05em}.footer-links{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end}.footer-links a{display:flex;align-items:center;gap:7px;padding:12px 15px;border:1px solid var(--line);border-radius:10px;color:var(--ink);text-decoration:none;font-size:14px}.footer-links a:hover{border-color:var(--acid);color:var(--acid)}.site-footer>p{grid-column:1/-1;margin:28px 0 0;padding-top:20px;border-top:1px solid var(--line);font:500 11px/1.5 var(--mono);color:var(--muted)}@media(max-width:680px){.site-footer{grid-template-columns:1fr;padding-top:60px}.footer-links{justify-content:flex-start}}
</style>
