---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import "../styles/global.css";
---

<MainLayout title="Yoyo | About / 关于">

<Navbar />

<section class="about-page">

  <!-- Hero -->
  <div class="hero">
    <h1>关于我</h1>
    <span class="en">About Me</span>
    <h2>Yoyo</h2>
    <p class="tagline">
      同济大学 · 智能制造工程 · AI × 机器人 × 医疗
      <span class="en">Tongji University · Intelligent Manufacturing · AI × Robotics × Healthcare</span>
    </p>
  </div>

  <!-- Profile Card -->
  <section class="card profile-card">
    <div class="avatar">🌱</div>
    <h2>基本信息
      <span class="en">Profile</span>
    </h2>
    <div class="info-grid">
      <div class="info-item">
        <strong>姓名
          <span class="en">Name</span>
        </strong>
        <span>Yoyo</span>
      </div>
      <div class="info-item">
        <strong>学校
          <span class="en">University</span>
        </strong>
        <span>同济大学
          <span class="en">Tongji University</span>
        </span>
      </div>
      <div class="info-item">
        <strong>专业
          <span class="en">Major</span>
        </strong>
        <span>智能制造工程
          <span class="en">Intelligent Manufacturing Engineering</span>
        </span>
      </div>
      <div class="info-item">
        <strong>年级
          <span class="en">Year</span>
        </strong>
        <span>2024级本科
          <span class="en">Class of 2028</span>
        </span>
      </div>
      <div class="info-item">
        <strong>学院
          <span class="en">College</span>
        </strong>
        <span>机械与能源工程学院
          <span class="en">School of Mechanical and Energy Engineering</span>
        </span>
      </div>
      <div class="info-item">
        <strong>兴趣
          <span class="en">Interests</span>
        </strong>
        <span>AI · 机器人 · 医疗AI
          <span class="en">AI · Robotics · Medical AI</span>
        </span>
      </div>
    </div>
  </section>

  <!-- Education -->
  <section class="card">
    <h2>教育背景
      <span class="en">Education</span>
    </h2>
    <div class="item">
      <h3>同济大学 · 机械与能源工程学院
        <span class="en">Tongji University, 2024 – Present</span>
      </h3>
      <p>
        智能制造工程专业 · 本科
        <span class="en">B.S. in Intelligent Manufacturing Engineering</span>
      </p>
      <div class="gpa">
        <div class="gpa-item">
          <span class="gpa-label">第一学期</span>
          <span class="gpa-value">5.0</span>
        </div>
        <div class="gpa-item">
          <span class="gpa-label">第二学期</span>
          <span class="gpa-value">5.0</span>
        </div>
        <div class="gpa-item">
          <span class="gpa-label">第三学期</span>
          <span class="gpa-value">4.88</span>
        </div>
        <div class="gpa-item">
          <span class="gpa-label">第四学期</span>
          <span class="gpa-value">4.77</span>
        </div>
      </div>
      <p class="rank">
        智造类专业第一
        <span class="en">Ranked 1st in Intelligent Manufacturing</span>
      </p>
    </div>
  </section>

  <!-- Academic Honors -->
  <section class="card">
    <h2>学术荣誉
      <span class="en">Academic Honors</span>
    </h2>
    <div class="honor-section">
      <h3>奖学金
        <span class="en">Scholarship</span>
      </h3>
      <div class="honor-item">
        <span class="honor-icon">🏆</span>
        <div>
          <strong>国家奖学金</strong>
          <span class="en">National Scholarship (2024-2025)</span>
          <p>2024-2025学年度</p>
        </div>
      </div>
    </div>
    <div class="honor-section">
      <h3>竞赛获奖
        <span class="en">Competitions</span>
      </h3>
      <ul class="honor-list">
        <li>
          <span class="honor-icon">🥇</span>
          <div>
            <strong>中国大学生数学竞赛</strong>
            <span class="en">Shanghai First Prize, CCMC</span>
            <p>上海市一等奖</p>
          </div>
        </li>
        <li>
          <span class="honor-icon">🥈</span>
          <div>
            <strong>工程力学奥赛</strong>
            <span class="en">Engineering Mechanics Olympiad</span>
            <p>个人二等奖 · 团体三等奖
              <span class="en">Individual 2nd Prize · Team 3rd Prize</span>
            </p>
          </div>
        </li>
        <li>
          <span class="honor-icon">🥉</span>
          <div>
            <strong>挑战杯</strong>
            <span class="en">Challenge Cup</span>
            <p>校内二等奖
              <span class="en">Campus 2nd Prize</span>
            </p>
          </div>
        </li>
        <li>
          <span class="honor-icon">🎖️</span>
          <div>
            <strong>互联网+产业赛道</strong>
            <span class="en">Internet+ Industry Track</span>
            <p>校内银奖
              <span class="en">Campus Silver Award</span>
            </p>
          </div>
        </li>
        <li>
          <span class="honor-icon">🥇</span>
          <div>
            <strong>国创赛</strong>
            <span class="en">National Innovation Competition</span>
            <p>校内金奖
              <span class="en">Campus Gold Award</span>
            </p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- Research Projects -->
  <section class="card">
    <h2>科研项目
      <span class="en">Research Projects</span>
    </h2>
    <div class="project">
      <div class="project-header">
        <span class="project-icon">✈️</span>
        <h3>LSTM航空发动机剩余使用寿命预测
          <span class="en">LSTM-based Aero-engine RUL Prediction</span>
        </h3>
      </div>
      <p class="project-role">第一主持人
        <span class="en">First Author & Project Lead</span>
      </p>
      <p>
        基于深度学习的航空发动机剩余使用寿命预测模型研究，使用LSTM网络处理时序传感器数据。
        <span class="en">Deep learning-based remaining useful life prediction for aero-engines using LSTM networks on time-series sensor data.</span>
      </p>
      <div class="project-tags">
        <span>LSTM</span>
        <span>航空发动机</span>
        <span>RUL预测</span>
        <span>国豪论坛汇报</span>
      </div>
      <p class="project-note">
        国豪论坛汇报
        <span class="en">Presented at Guohao Forum</span>
      </p>
    </div>

    <div class="project">
      <div class="project-header">
        <span class="project-icon">🖨️</span>
        <h3>3D打印质量研究
          <span class="en">3D Printing Quality Research</span>
        </h3>
      </div>
      <p class="project-role">核心成员
        <span class="en">Core Team Member</span>
      </p>
      <p>
        研究3D打印工艺参数与成型质量之间的关系，探索智能制造中的质量控制方法。
        <span class="en">Investigating the relationship between 3D printing process parameters and quality outcomes in intelligent manufacturing.</span>
      </p>
      <div class="project-tags">
        <span>3D打印</span>
        <span>智能制造</span>
        <span>质量控制</span>
        <span>上海市创新创业项目</span>
      </div>
      <p class="project-note">
        上海市创新创业项目
        <span class="en">Shanghai Innovation & Entrepreneurship Project</span>
      </p>
    </div>

    <div class="project">
      <div class="project-header">
        <span class="project-icon">🧠</span>
        <h3>肺癌脑膜转移预测系统
          <span class="en">Lung Cancer LM Metastasis Prediction System</span>
        </h3>
      </div>
      <p class="project-role">核心成员
        <span class="en">Core Team Member</span>
      </p>
      <p>
        基于深度学习的肺癌脑膜转移MRI预测系统，使用多模态AI模型辅助临床诊断。
        <span class="en">Deep learning-based MRI prediction system for lung cancer leptomeningeal metastasis using multimodal AI to assist clinical diagnosis.</span>
      </p>
      <div class="project-tags">
        <span>医学影像</span>
        <span>深度学习</span>
        <span>多模态AI</span>
        <span>国创赛金奖</span>
        <span>国家级项目</span>
      </div>
      <p class="project-note">
        国创赛金奖 · 国家级项目
        <span class="en">National Innovation Competition Gold Award · National-level Project</span>
      </p>
    </div>
  </section>

  <!-- Skills & Experience -->
  <section class="card">
    <h2>技能与经历
      <span class="en">Skills & Experience</span>
    </h2>
    <div class="skill-section">
      <div class="skill-item">
        <span class="skill-icon">🤖</span>
        <div>
          <h3>具身智能机器人系统
            <span class="en">Embodied Intelligent Robot Systems</span>
          </h3>
          <p>上海创智学院
            <span class="en">Shanghai Innovation Institute</span>
          </p>
        </div>
      </div>
      <div class="skill-item">
        <span class="skill-icon">🦾</span>
        <div>
          <h3>同济大学人形机器人战队 · 机械组
            <span class="en">Tongji Humanoid Robot Team · Mechanical Group</span>
          </h3>
          <p>参与人形机器人机械结构设计与集成
            <span class="en">Mechanical design and integration for humanoid robots</span>
          </p>
        </div>
      </div>
      <div class="skill-item">
        <span class="skill-icon">🌍</span>
        <div>
          <h3>外研社国才杯
            <span class="en">FLTRP Guocai Cup</span>
          </h3>
          <p>英语演讲比赛 · 银奖
            <span class="en">English Speech Competition · Silver Award</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="card philosophy-card">
    <h2>个人理念
      <span class="en">Philosophy</span>
    </h2>
    <blockquote>
      以工科之基，融AI之智，怀济世之心。
      <span class="en">Founded in engineering, empowered by AI, driven by purpose.</span>
    </blockquote>
    <p>
      我相信技术的真正价值在于解决实际问题。从智能制造到医疗AI，从机器人到深度学习，我希望将工程思维与人工智能结合，创造能够服务于人类的智能系统。
      <span class="en">I believe technology's true value lies in solving real problems. From intelligent manufacturing to medical AI, from robotics to deep learning, I aim to combine engineering thinking with AI to build intelligent systems that serve humanity.</span>
    </p>
  </section>

</section>

</MainLayout>

<style>
.about-page{
  padding: 140px 10% 80px;
  background: linear-gradient(135deg, #FFF9F5 0%, #F0FFF4 50%, #F5F0FF 100%);
  min-height: 100vh;
}

.hero{
  text-align: center;
  margin-bottom: 80px;
}

.hero h1{
  font-size: 72px;
  margin-bottom: 10px;
  color: #444;
}

.hero h2{
  font-size: 42px;
  font-weight: 300;
  margin: 15px 0;
  color: #666;
}

.hero .tagline{
  font-size: 18px;
  color: #888;
  line-height: 1.8;
}

.card{
  margin-bottom: 40px;
  padding: 40px;
  border-radius: 35px;
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(20px);
  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
}

.card h2{
  font-size: 32px;
  margin-bottom: 25px;
  color: #444;
}

.profile-card{
  text-align: center;
}

.profile-card .avatar{
  font-size: 60px;
  margin-bottom: 15px;
}

.info-grid{
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: 20px;
}

.info-item{
  text-align: left;
  padding: 15px 20px;
  border-radius: 20px;
  background: rgba(255, 214, 232, 0.4);
}

.info-item strong{
  display: block;
  font-size: 15px;
  color: #888;
  margin-bottom: 5px;
}

.info-item span{
  font-size: 17px;
  color: #444;
}

.item{
  margin-bottom: 20px;
}

.item h3{
  font-size: 22px;
  margin-bottom: 10px;
}

.item p{
  font-size: 17px;
  color: #666;
  line-height: 1.8;
}

.gpa{
  display: flex;
  gap: 15px;
  margin: 20px 0;
  flex-wrap: wrap;
}

.gpa-item{
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 15px 25px;
  border-radius: 20px;
  background: rgba(214, 236, 255, 0.6);
  min-width: 90px;
}

.gpa-label{
  font-size: 13px;
  color: #888;
}

.gpa-value{
  font-size: 28px;
  font-weight: 700;
  color: #5B8FB9;
}

.rank{
  font-weight: 600;
  color: #E8759A !important;
  margin-top: 10px;
}

.honor-section{
  margin-bottom: 30px;
}

.honor-section h3{
  font-size: 22px;
  margin-bottom: 15px;
  padding-bottom: 10px;
  border-bottom: 2px solid rgba(255, 214, 232, 0.6);
}

.honor-item{
  display: flex;
  gap: 15px;
  padding: 15px 20px;
  border-radius: 20px;
  background: rgba(216, 243, 220, 0.4);
  margin-bottom: 12px;
  align-items: flex-start;
}

.honor-item strong{
  font-size: 18px;
  color: #444;
}

.honor-item p{
  font-size: 15px;
  color: #777;
  margin: 3px 0 0;
}

.honor-list{
  list-style: none;
  padding: 0;
  margin: 0;
}

.honor-list li{
  display: flex;
  gap: 15px;
  padding: 15px 20px;
  border-radius: 20px;
  background: rgba(255, 241, 201, 0.5);
  margin-bottom: 12px;
  align-items: flex-start;
}

.honor-list li strong{
  font-size: 18px;
  color: #444;
}

.honor-list li p{
  font-size: 15px;
  color: #777;
  margin: 3px 0 0;
}

.honor-icon{
  font-size: 24px;
  flex-shrink: 0;
}

.project{
  padding: 25px;
  border-radius: 25px;
  background: rgba(232, 217, 255, 0.35);
  margin-bottom: 20px;
  transition: transform 0.3s;
}

.project:hover{
  transform: translateY(-5px);
}

.project-header{
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 10px;
}

.project-icon{
  font-size: 30px;
}

.project h3{
  font-size: 20px;
  margin: 0;
}

.project-role{
  font-size: 14px;
  color: #A87FC4 !important;
  font-weight: 600;
  margin: 8px 0 !important;
}

.project p{
  font-size: 16px;
  color: #555;
  line-height: 1.8;
  margin: 10px 0;
}

.project-tags{
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 15px 0;
}

.project-tags span{
  padding: 6px 16px;
  border-radius: 20px;
  font-size: 13px;
  background: rgba(255, 255, 255, 0.7);
  color: #666;
}

.project-note{
  font-size: 14px;
  color: #888;
  margin: 8px 0 0 !important;
}

.skill-section{
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.skill-item{
  padding: 25px;
  border-radius: 25px;
  background: rgba(255, 214, 232, 0.35);
  display: flex;
  gap: 15px;
  align-items: flex-start;
  transition: transform 0.3s;
}

.skill-item:hover{
  transform: translateY(-5px);
}

.skill-icon{
  font-size: 36px;
  flex-shrink: 0;
}

.skill-item h3{
  font-size: 18px;
  margin: 0 0 8px;
}

.skill-item p{
  font-size: 15px;
  color: #777;
  margin: 0;
  line-height: 1.6;
}

.philosophy-card{
  text-align: center;
  background: linear-gradient(135deg, rgba(255, 214, 232, 0.5), rgba(216, 243, 220, 0.5));
}

.philosophy-card blockquote{
  font-size: 26px;
  color: #6B4C7A;
  font-weight: 600;
  margin: 25px 0;
  line-height: 1.8;
  font-style: italic;
}

.philosophy-card p{
  font-size: 17px;
  color: #666;
  line-height: 1.9;
  max-width: 700px;
  margin: 0 auto;
}

@media (max-width: 900px){
  .info-grid{
    grid-template-columns: 1fr;
  }
  .skill-section{
    grid-template-columns: 1fr;
  }
  .hero h1{
    font-size: 52px;
  }
  .hero h2{
    font-size: 32px;
  }
}
</style>