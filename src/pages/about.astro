---
import MainLayout from "../layouts/MainLayout.astro";
import { ArrowUpRight, Award, Blocks, Compass, GraduationCap } from "@lucide/astro";
const values = [
  {no:"01",title:"从问题出发",en:"Problem first",text:"先确认问题值得解决，再决定模型、数据和工程路径。",Icon:Compass},
  {no:"02",title:"跨过学科边界",en:"Cross disciplines",text:"医学、AI 与机械不是三座孤岛，而是可以彼此解释的系统。",Icon:Blocks},
  {no:"03",title:"让结果可验证",en:"Make it testable",text:"用实验、图表、结构和文档，让想法能够被复现、被讨论。",Icon:Award},
];
---
<MainLayout title="关于 Yoyo" description="认识 Yoyo：同济大学智能制造工程本科生，关注医学 AI、深度学习与机器人。">
  <header class="about-hero section-shell">
    <div class="portrait-mark" aria-hidden="true"><span>𝒴</span><small>2024—NOW</small></div>
    <div class="about-intro"><span class="eyebrow">ABOUT / YOYO</span><h1>在工程与智能之间，<br />寻找真实问题的<span>新解法。</span></h1><p>我是同济大学智能制造工程专业本科生 Yoyo。我的学习轨迹从机械与数学出发，逐渐延伸到深度学习、医学影像和具身智能。</p><p>我享受把一个模糊问题拆成清晰路径的过程：理解场景、组织数据、建立模型、验证结果，再把它讲给别人听。</p></div>
  </header>

  <section class="beliefs section-shell">
    <div class="section-heading" data-reveal><div><span class="eyebrow">HOW I WORK</span><h2>我的工作方式</h2></div><p>技术会不断变化，但理解问题、连接知识和验证结果，是我希望长期保留的能力。</p></div>
    <div class="belief-grid">{values.map(({no,title,en,text,Icon}) => <article data-reveal><div><span>{no}</span><Icon size={25} strokeWidth={1.5} /></div><h3>{title}</h3><p class="value-en">{en}</p><p>{text}</p></article>)}</div>
  </section>

  <section class="timeline section-shell" data-reveal>
    <div class="timeline-head"><span class="eyebrow">LEARNING PATH</span><h2>一条仍在延伸的轨迹</h2></div>
    <div class="timeline-list">
      <article><time>2024</time><div><h3>进入同济大学</h3><p>智能制造工程 · 机械工程与机器人学院</p></div><span>专业起点</span></article>
      <article><time>2024至今</time><div><h3>打牢数学与工程基础</h3><p>四学期绩点 5.0 / 5.0 / 4.88 / 4.78，智能制造类专业第一。</p></div><span>国家奖学金</span></article>
      <article><time>2025至今</time><div><h3>把 AI 带入工程问题</h3><p>航空发动机 RUL、3D 打印质量控制、数学建模与机械创新。</p></div><span>研究实践</span></article>
      <article><time>NOW</time><div><h3>走向医学 AI 与具身智能</h3><p>聚焦 MRI、多模态深度学习、可解释 AI 与机器人系统。</p></div><span>持续探索</span></article>
    </div>
  </section>

  <section class="honors section-shell" data-reveal>
    <div><GraduationCap size={32} strokeWidth={1.4} /><span class="eyebrow">HIGHLIGHTS</span><h2>荣誉只是坐标，<br />下一步仍然向前。</h2></div>
    <ul><li><span>01</span><strong>国家奖学金</strong><small>2024-2025；2025-2026连续两个学年</small></li><li><span>02</span><strong>中国大学生数学竞赛</strong><small>上海市一等奖</small></li><li><span>03</span><strong>国际工程力学奥林匹克竞赛</strong><small>个人二等奖 · 团体三等奖</small></li><li><span>04</span><strong>国创赛校内选拔</strong><small>金奖 · 国家级立项</small></li></ul>
  </section>

  <section class="about-cta section-shell" data-reveal><p>想继续了解我的具体实践？</p><h2>从一个项目开始。</h2><a class="button-primary" href="/research">打开项目档案 <ArrowUpRight size={18} /></a></section>
</MainLayout>

<style>
  .about-hero{display:grid;grid-template-columns:.48fr 1.2fr;gap:clamp(45px,8vw,120px);align-items:center;padding-top:160px;padding-bottom:120px}.portrait-mark{position:relative;display:grid;place-items:center;aspect-ratio:1;border:1px solid var(--line);border-radius:50%;background:radial-gradient(circle,rgba(201,255,95,.14),transparent 65%)}.portrait-mark::before,.portrait-mark::after{content:"";position:absolute;border:1px solid rgba(117,230,208,.18);border-radius:50%;inset:12%;animation:spin 18s linear infinite}.portrait-mark::after{inset:25%;border-style:dashed;animation-direction:reverse}.portrait-mark span{font:850 clamp(90px,14vw,210px)/1 var(--display);letter-spacing:-.08em;color:var(--acid)}.portrait-mark small{position:absolute;bottom:10%;font:500 9px var(--mono);letter-spacing:.16em;color:var(--muted)}.about-intro h1{margin:20px 0 30px;font:760 clamp(48px,7vw,92px)/.94 var(--display);letter-spacing:-.065em}.about-intro h1 span{color:var(--acid)}.about-intro>p{max-width:760px;color:var(--muted);font-size:18px;line-height:1.9}.beliefs{padding-top:90px;padding-bottom:120px;border-top:1px solid var(--line)}.belief-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.belief-grid article{min-height:320px;padding:25px;display:flex;flex-direction:column;border:1px solid var(--line);border-radius:17px;background:rgba(16,30,26,.65)}.belief-grid article>div{display:flex;justify-content:space-between;color:var(--acid)}.belief-grid article>div span{font:600 10px var(--mono)}.belief-grid h3{margin:auto 0 0;font:700 30px/1.1 var(--display);letter-spacing:-.035em}.belief-grid .value-en{margin:5px 0 15px;color:var(--cyan);font:500 11px var(--mono);text-transform:uppercase}.belief-grid article>p:last-child{margin:0;color:var(--muted)}.timeline{display:grid;grid-template-columns:.65fr 1.35fr;gap:70px;padding-top:100px;padding-bottom:120px;border-top:1px solid var(--line)}.timeline-head h2{margin:15px 0;font:730 clamp(38px,5vw,64px)/1 var(--display);letter-spacing:-.05em}.timeline-list{border-top:1px solid var(--line)}.timeline-list article{display:grid;grid-template-columns:80px 1fr auto;gap:18px;padding:27px 0;border-bottom:1px solid var(--line)}.timeline-list time{font:600 10px var(--mono);color:var(--acid)}.timeline-list h3{margin:0;font-size:19px}.timeline-list p{margin:5px 0 0;color:var(--muted);font-size:14px}.timeline-list article>span{color:var(--cyan);font:500 10px var(--mono)}.honors{display:grid;grid-template-columns:.8fr 1.2fr;gap:80px;padding:90px 0 120px;border-top:1px solid var(--line)}.honors>div>svg{display:block;margin-bottom:30px;color:var(--acid)}.honors h2{margin:18px 0 0;font:730 clamp(38px,5vw,64px)/1 var(--display);letter-spacing:-.05em}.honors ul{margin:0;padding:0;list-style:none;border-top:1px solid var(--line)}.honors li{display:grid;grid-template-columns:35px 1fr auto;gap:14px;align-items:center;padding:20px 0;border-bottom:1px solid var(--line)}.honors li span{font:600 10px var(--mono);color:var(--acid)}.honors li strong{font-size:15px}.honors li small{color:var(--muted)}.about-cta{padding:100px 0 120px;border-top:1px solid var(--line);text-align:center}.about-cta p{color:var(--muted)}.about-cta h2{margin:0 0 30px;font:760 clamp(55px,9vw,115px)/1 var(--display);letter-spacing:-.07em}
  @keyframes spin{to{transform:rotate(1turn)}}@media(max-width:820px){.about-hero,.timeline,.honors{grid-template-columns:1fr}.portrait-mark{width:min(320px,80vw)}.belief-grid{grid-template-columns:1fr}.belief-grid article{min-height:240px}.timeline,.honors{gap:38px}}@media(max-width:520px){.about-hero{padding-top:115px}.timeline-list article{grid-template-columns:70px 1fr}.timeline-list article>span{grid-column:2}.honors li{grid-template-columns:28px 1fr}.honors li small{grid-column:2}}
  .portrait-mark span{font-family:"Palace Script MT","Brush Script MT","Segoe Script",cursive;font-weight:400;letter-spacing:0;transform:rotate(-7deg) translateY(-2%)}
  .about-intro h1{font-size:clamp(46px,6.25vw,82px)}
  .about-intro h1 span{white-space:nowrap}
</style>
