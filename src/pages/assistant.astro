---
import MainLayout from "../layouts/MainLayout.astro";
import { ArrowUpRight, Bot, Sparkles } from "@lucide/astro";
---
<MainLayout title="AI 导览 · Yoyo" description="通过预设问题快速了解 Yoyo 的研究方向、代表项目和技能。">
  <section class="guide section-shell">
    <header><div><span class="eyebrow">PORTFOLIO GUIDE / BETA</span><h1>不知道先看哪里？<br />可以从这里开始。</h1></div><p>选一个你关心的问题，我会给你一段简短介绍，再带你去对应的页面。</p></header>
    <div class="guide-shell" data-guide>
      <aside><div class="bot-mark"><Bot size={34} strokeWidth={1.45} /></div><span>YOYO / RESEARCH GUIDE</span><p>当前知识范围：研究项目、技能、教育经历与未来方向。</p><div class="guide-status"><i></i> READY TO EXPLORE</div></aside>
      <div class="conversation">
        <div class="message assistant-message"><div class="avatar"><Sparkles size={18} /></div><div><small>GUIDE</small><p>你好，我可以带你快速浏览 Yoyo 的研究与工程实践。你想先从哪里开始？</p></div></div>
        <div class="answer" data-answer aria-live="polite"><p>选择下方任意问题，答案会显示在这里。</p></div>
        <div class="questions">
          <button data-question="focus">她目前最关注什么？</button><button data-question="best">最有代表性的项目？</button><button data-question="skills">她擅长哪些技能？</button><button data-question="path">她的研究路径是什么？</button>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script is:inline>
  const answers = {
    focus: { zh: '我现在最关注医学影像 AI、多模态深度学习与具身智能，希望把算法放到真实的医学和工程场景里检验。', en: 'I am currently most interested in medical imaging AI, multimodal deep learning, and embodied intelligence, especially testing methods in real medical and engineering settings.', href: '/about', zhLabel: '了解我的学习路径', enLabel: 'See my learning path' },
    best: { zh: '肺癌脑膜转移预测系统最能代表我的跨学科实践，内容包括 MRI 数据处理、模型设计、多模态融合和结果解释。', en: 'The leptomeningeal metastasis prediction project best represents my cross-disciplinary work, from MRI processing and model design to multimodal fusion and interpretation.', href: '/projects/lung-cancer-lm-prediction', zhLabel: '打开代表项目', enLabel: 'Open the featured project' },
    skills: { zh: '我主要使用 Python、PyTorch、深度学习、医学影像和 Transformer，也有 SolidWorks、机械设计与数学建模经验。', en: 'My main tools include Python, PyTorch, deep learning, medical imaging, and Transformers. I also have experience with SolidWorks, mechanical design, and mathematical modeling.', href: '/resume', zhLabel: '查看完整简历', enLabel: 'Read the full CV' },
    path: { zh: '我从机械与数学基础出发，通过时序预测和制造质量项目接触 AI，之后逐步把兴趣转向医学影像与机器人系统。', en: 'I started with mechanics and mathematics, moved into AI through time-series prediction and manufacturing projects, and gradually focused on medical imaging and robotics.', href: '/research', zhLabel: '浏览全部项目', enLabel: 'Browse all projects' }
  };
  const setupGuide = () => {
    const root = document.querySelector('[data-guide]');
    const output = root?.querySelector('[data-answer]');
    if (!root || !output || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    root.querySelectorAll('[data-question]').forEach((button) => button.addEventListener('click', () => {
      const item = answers[button.dataset.question];
      const english = document.documentElement.dataset.language === 'en';
      root.querySelectorAll('[data-question]').forEach((node) => node.classList.toggle('active', node === button));
      output.classList.remove('show');
      requestAnimationFrame(() => {
        output.innerHTML = `<p>${english ? item.en : item.zh}</p><a href="${item.href}">${english ? item.enLabel : item.zhLabel} <span>↗</span></a>`;
        output.classList.add('show');
        document.dispatchEvent(new CustomEvent('site:content-change'));
      });
    }));
  };
  setupGuide();
  document.addEventListener('astro:page-load', setupGuide);
</script>

<style>
  .guide{padding-top:165px;padding-bottom:120px}.guide>header{display:grid;grid-template-columns:1fr .48fr;gap:55px;align-items:end;margin-bottom:60px}.guide h1{margin:17px 0 0;font:760 clamp(52px,8vw,104px)/.9 var(--display);letter-spacing:-.07em}.guide>header>p{margin:0 0 8px;color:var(--muted);font-size:17px}.guide-shell{display:grid;grid-template-columns:290px 1fr;min-height:520px;border:1px solid var(--line);border-radius:20px;overflow:hidden;background:rgba(16,30,26,.62)}.guide-shell>aside{padding:28px;display:flex;flex-direction:column;border-right:1px solid var(--line)}.bot-mark{display:grid;place-items:center;width:65px;height:65px;margin-bottom:25px;border-radius:18px;background:var(--acid);color:var(--bg)}.guide-shell>aside>span{font:600 10px var(--mono);letter-spacing:.12em}.guide-shell>aside>p{color:var(--muted);font-size:13px}.guide-status{margin-top:auto;padding-top:20px;border-top:1px solid var(--line);color:var(--muted);font:500 9px var(--mono);letter-spacing:.1em}.guide-status i{display:inline-block;width:7px;height:7px;margin-right:7px;border-radius:50%;background:var(--acid);box-shadow:0 0 12px var(--acid)}.conversation{padding:clamp(25px,5vw,60px)}.message{display:flex;gap:13px;align-items:flex-start}.avatar{display:grid;place-items:center;flex:0 0 40px;height:40px;border:1px solid var(--line);border-radius:11px;color:var(--acid)}.message small{font:600 9px var(--mono);color:var(--cyan);letter-spacing:.12em}.message p{max-width:620px;margin:7px 0 0;font-size:18px}.answer{min-height:165px;margin:28px 0;padding:24px;border:1px solid var(--line);border-radius:14px;background:rgba(7,17,15,.6);color:var(--muted);transition:.25s var(--ease)}.answer.show{border-color:rgba(201,255,95,.35);color:var(--ink);animation:answerIn .35s var(--ease)}.answer p{margin:0;max-width:700px}.answer a{display:inline-flex;gap:8px;margin-top:18px;color:var(--acid);text-decoration:none;font-weight:650}.questions{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.questions button{padding:15px;text-align:left;border:1px solid var(--line);border-radius:10px;background:transparent;color:var(--muted);cursor:pointer;transition:.2s var(--ease)}.questions button:hover,.questions button.active{border-color:var(--acid);color:var(--acid);background:rgba(201,255,95,.04)}@keyframes answerIn{from{opacity:.25;transform:translateY(7px)}}
  @media(max-width:780px){.guide{padding-top:120px}.guide>header{grid-template-columns:1fr}.guide-shell{grid-template-columns:1fr}.guide-shell>aside{border-right:0;border-bottom:1px solid var(--line)}.guide-status{margin-top:25px}.questions{grid-template-columns:1fr}}@media(max-width:480px){.conversation{padding:20px}.message p{font-size:16px}.answer{min-height:190px}}
</style>
