---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import "../styles/global.css";
---

<MainLayout title="Yoyo | AI Research Assistant">


<Navbar />


<section class="assistant-page">


<div class="header">


<div class="robot">
🤖
</div>


<h1>
AI Research Assistant
</h1>


<p>

An intelligent assistant
for exploring my research journey.

</p>


</div>





<div class="chat-container">


<div class="message user">


<div class="avatar">
👤
</div>


<div class="bubble">

Tell me about your
medical AI research.

</div>


</div>





<div class="message ai">


<div class="avatar">
🤖
</div>


<div class="bubble">


Yoyo's research focuses on
medical imaging AI,
especially MRI-based disease
prediction and multimodal
deep learning systems.


<br><br>


Current interests include:

<br>

• MRI Analysis

<br>

• Vision Language Models

<br>

• Explainable AI


</div>


</div>



</div>






<div class="input-area">


<input

placeholder="Ask about my research..."

disabled

/>


<button
onclick="gtag('event', 'assistant_usage', {interaction: 'send_click'})">

Send

</button>


</div>







<div class="future">


<h2>

Future Integration

</h2>


<div class="features">


<div>

📚

<br>

Research Papers

</div>



<div>

🧠

<br>

AI Models

</div>



<div>

💻

<br>

Code Repository

</div>



<div>

📖

<br>

Knowledge Base

</div>



</div>



</div>



</section>


</MainLayout>





