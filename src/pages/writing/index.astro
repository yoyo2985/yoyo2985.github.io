---
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";

import { getCollection } from "astro:content";


const posts = await getCollection("writing");


const sortedPosts = posts.sort(
(a,b)=>
new Date(b.data.date).getTime()
-
new Date(a.data.date).getTime()
);

---


<MainLayout title="Yoyo | Writing">


<Navbar />


<section class="writing">


<h1>
Writing
</h1>


<p>
Thoughts, research notes and life records.
</p>



<div class="posts">


{
sortedPosts.map(post=>(

<a 
href={`/writing/${post.id}`}
class="post">


<div>

<span>
{post.data.category}
</span>


<h2>
{post.data.title}
</h2>


<p>
{post.data.description}
</p>


</div>


<time>

{post.data.date}

</time>


</a>

))
}


</div>


</section>



</MainLayout>




<style>


.writing{


padding:140px 10%;


background:#FFF9F5;


min-height:100vh;


}



h1{


font-size:70px;


text-align:center;


}



.writing>p{


text-align:center;


font-size:20px;


color:#777;


}




.posts{


margin-top:70px;


display:flex;


flex-direction:column;


gap:30px;


}



.post{


padding:35px;


border-radius:30px;


background:white;


text-decoration:none;


color:#555;


display:flex;


justify-content:space-between;


transition:.3s;


}



.post:hover{


transform:translateY(-8px);


}


.post span{


background:#FFE5F0;


padding:8px 20px;


border-radius:20px;


}



</style>