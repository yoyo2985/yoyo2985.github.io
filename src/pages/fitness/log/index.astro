---
import MainLayout from "../../../layouts/MainLayout.astro";
import Navbar from "../../../components/Navbar.astro";
import { getCollection } from "astro:content";

const workouts = await getCollection("fitness");

const sorted = workouts.sort(
  (a, b) =>
    new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---


<MainLayout title="Yoyo | Training Log">


<Navbar />


<section class="log">


<div class="header">

<h1>
Training Log
</h1>

<p>
History of my fitness journey.
</p>

</div>


<div class="entries">

{
sorted.map((w) => (

<a
  href={`/fitness/${w.id}`}
  class="entry"
>

  <div class="entry-icon">
    {w.data.type === "Strength" ? "💪" : w.data.type === "Recovery" ? "🧘" : "🏃"}
  </div>

  <div class="entry-content">
    <span class="type">{w.data.type}</span>
    <h2>{w.data.title}</h2>
    <p>{w.data.description}</p>
  </div>

  <time>{w.data.date}</time>

</a>

))}

</div>


</section>


</MainLayout>



<style>


.log{

padding:140px 10%;

background:#FFF9F5;

min-height:100vh;

}



.header{

text-align:center;

margin-bottom:70px;

}



.header h1{

font-size:70px;

}



.header p{

font-size:20px;

color:#777;

}



.entries{

display:flex;

flex-direction:column;

gap:25px;

}



.entry{

display:flex;

align-items:center;

gap:30px;

padding:35px;

border-radius:30px;

background:white;

text-decoration:none;

color:#555;

box-shadow:

0 15px 40px rgba(0,0,0,.08);

transition:.3s;

}



.entry:hover{

transform:translateY(-8px);

}



.entry-icon{

font-size:45px;

width:70px;

height:70px;

display:flex;

align-items:center;

justify-content:center;

border-radius:20px;

background:#E4EEFF;

}



.entry-content{

flex:1;

}



.entry-content .type{

display:inline-block;

padding:6px 16px;

border-radius:20px;

background:#FFE5F0;

font-size:14px;

margin-bottom:8px;

}



.entry-content h2{

font-size:24px;

margin-bottom:6px;

}



.entry-content p{

color:#777;

font-size:16px;

}



.entry time{

color:#999;

font-size:16px;

white-space:nowrap;

}



@media(max-width:900px){

.entry{

flex-wrap:wrap;

}



.entry time{

width:100%;

}

}


</style>
