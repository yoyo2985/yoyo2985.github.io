---
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const workouts = await getCollection("fitness");
  return workouts.map((w) => ({
    params: { id: w.id },
    props: { workout: w },
  }));
}

const { workout } = Astro.props;
const { Content } = await render(workout);
---


<MainLayout title={`Yoyo | ${workout.data.title}`}>


<Navbar />


<section class="detail">


<div class="header">

<a href="/fitness" class="back">← Back to Fitness</a>

<div class="type-badge">
  {workout.data.type === "Strength" ? "💪" : workout.data.type === "Recovery" ? "🧘" : "🏃"}
  {workout.data.type}
</div>

<h1>{workout.data.title}</h1>

<time>{workout.data.date}</time>

</div>


<div class="content">

<Content />

</div>


{workout.data.feeling && (

<div class="feeling">

<h2>How I felt</h2>

<p>{workout.data.feeling}</p>

</div>

)}


</section>


</MainLayout>



<style>


.detail{

padding:140px 10%;

background:#FFF9F5;

min-height:100vh;

}



.header{

text-align:center;

margin-bottom:50px;

}



.back{

display:inline-block;

color:#777;

text-decoration:none;

margin-bottom:30px;

}



.back:hover{

color:#555;

}



.type-badge{

display:inline-block;

padding:10px 24px;

border-radius:30px;

background:#E4EEFF;

font-size:16px;

margin-bottom:20px;

}



.header h1{

font-size:50px;

margin-bottom:15px;

}



.header time{

color:#999;

font-size:18px;

}



.content{

max-width:700px;

margin:0 auto;

background:white;

padding:50px;

border-radius:40px;

box-shadow:

0 15px 40px rgba(0,0,0,.08);

line-height:1.8;

}



.content h1,
.content h2{

margin-top:30px;

}



.content h1:first-child,
.content h2:first-child{

margin-top:0;

}



.feeling{

max-width:700px;

margin:40px auto 0;

padding:30px;

border-radius:30px;

background:#E8D9FF;

text-align:center;

}



.feeling h2{

font-size:24px;

margin-bottom:12px;

}



.feeling p{

color:#555;

font-size:18px;

}


</style>
