---
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import FitnessChart from "../../components/FitnessChart.astro";
import { getCollection } from "astro:content";

const workouts = await getCollection("fitness");

const records = workouts.sort(
  (a, b) =>
    new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const latest = records[0];
const previous = records[1];

const totalDays = records.length;
const totalMinutes = records.reduce(
  (sum, r) => sum + (r.data.duration || 0),
  0
);
const currentWeight = latest?.data.weight || 0;

const weightData = records
  .filter((r) => r.data.weight)
  .map((r) => ({
    label: r.data.date.slice(5),
    value: r.data.weight!,
  }))
  .reverse();

const durationData = records.map((r) => ({
  label: r.data.date.slice(5),
  value: r.data.duration || 0,
})).reverse();
---


<MainLayout title="Yoyo | Fitness">


<Navbar />


<section class="fitness">


<div class="hero">


<div class="emoji">
💪
</div>


<h1>
Fitness Lab
</h1>


<p>

Building strength,
discipline and myself.

</p>


</div>



<section class="today">


<h2>
Today
</h2>


{
latest ? (
  <div class="today-card">
    <div class="today-info">
      <h3>{latest.data.title}</h3>
      <p>{latest.data.date} · {latest.data.type}</p>
    </div>
    <span class="badge">{latest.data.mood} {latest.data.duration}min</span>
  </div>
) : (
  <div class="today-card empty">
    <p>No training records yet. Start logging!</p>
  </div>
)
}


</section>



<section class="analytics">


<h2>
Analytics
</h2>


<div class="stats">

<div class="stat-card">
  <h3>{totalDays}</h3>
  <p>Training Days</p>
</div>

<div class="stat-card">
  <h3>{Math.round(totalMinutes / 60)}h</h3>
  <p>Total Time</p>
</div>

<div class="stat-card">
  <h3>{currentWeight}kg</h3>
  <p>Current Weight</p>
</div>

</div>


</section>



<section class="charts">


<h2>
Trends
</h2>


<div class="chart-grid">

<div class="chart-card">
  <h3>Weight Curve</h3>
  <FitnessChart
    type="line"
    labels={weightData.map((d) => d.label)}
    data={weightData.map((d) => d.value)}
    label="Weight (kg)"
    color="#FF9BC5"
  />
</div>

<div class="chart-card">
  <h3>Training Duration</h3>
  <FitnessChart
    type="bar"
    labels={durationData.map((d) => d.label)}
    data={durationData.map((d) => d.value)}
    label="Duration (min)"
    color="#91BAFF"
  />
</div>

</div>


</section>



<section class="history">


<h2>
Training History
</h2>



<div class="records">

{
records.map((item) => (
  <a
    href={`/fitness/${item.id}`}
    class="record"
  >
    <div class="record-icon">
      {item.data.type === "Strength" ? "�" : item.data.type === "Recovery" ? "🧘" : "🏃"}
    </div>
    <div class="record-info">
      <span class="record-type">{item.data.type}</span>
      <h3>{item.data.title}</h3>
      <p>{item.data.description}</p>
    </div>
    <div class="record-meta">
      <span>{item.data.mood} {item.data.duration}min</span>
      <time>{item.data.date}</time>
    </div>
  </a>
))
}

</div>


</section>



<section class="philosophy">


<h2>
Fitness Philosophy
</h2>


<div class="philosophy-grid">

<div class="philosophy-card">
  <span class="icon">🧠</span>
  <h3>Brain</h3>
  <p>Train intelligence like a muscle.</p>
</div>

<div class="philosophy-card">
  <span class="icon">💪</span>
  <h3>Body</h3>
  <p>Build strength with consistency.</p>
</div>

<div class="philosophy-card">
  <span class="icon">🌱</span>
  <h3>Discipline</h3>
  <p>Small daily wins compound over years.</p>
</div>

</div>


</section>



</section>


</MainLayout>



<style>


.fitness{

padding:140px 10%;

background:#FFF9F5;

}



.hero{

text-align:center;

margin-bottom:40px;

}



.hero .emoji{

font-size:90px;

}



.hero h1{

font-size:70px;

margin:15px 0;

}



.hero p{

font-size:22px;

color:#777;

}



.today,
.analytics,
.charts,
.history,
.philosophy{

margin-top:100px;

}



h2{

font-size:45px;

margin-bottom:30px;

}



.today-card{

display:flex;

justify-content:space-between;

align-items:center;

background:#DFF7E3;

padding:40px;

border-radius:40px;

}



.today-card.empty{

justify-content:center;

text-align:center;

color:#999;

font-size:18px;

}



.today-info h3{

font-size:28px;

}



.today-info p{

color:#777;

margin-top:8px;

}



.badge{

background:#FFE5F0;

padding:12px 28px;

border-radius:30px;

font-size:16px;

}



.stats{

display:grid;

grid-template-columns:repeat(3,1fr);

gap:30px;

}



.stat-card{

background:#FFE5F0;

padding:40px;

border-radius:35px;

text-align:center;

transition:.3s;

}



.stat-card:hover{

transform:translateY(-8px);

}



.stat-card h3{

font-size:48px;

margin-bottom:10px;

}



.stat-card p{

color:#777;

font-size:18px;

}



.chart-grid{

display:grid;

grid-template-columns:repeat(2,1fr);

gap:30px;

}



.chart-card{

background:white;

padding:35px;

border-radius:35px;

box-shadow:0 15px 40px rgba(0,0,0,.08);

}



.chart-card h3{

font-size:22px;

margin-bottom:20px;

color:#555;

}



.records{

display:flex;

flex-direction:column;

gap:20px;

}



.record{

display:flex;

align-items:center;

gap:25px;

padding:30px 35px;

border-radius:30px;

background:white;

text-decoration:none;

color:#555;

box-shadow:0 10px 30px rgba(0,0,0,.06);

transition:.3s;

}



.record:hover{

transform:translateY(-6px);

box-shadow:0 15px 40px rgba(0,0,0,.1);

}



.record-icon{

font-size:40px;

width:60px;

height:60px;

display:flex;

align-items:center;

justify-content:center;

border-radius:18px;

background:#E4EEFF;

}



.record-info{

flex:1;

}



.record-type{

display:inline-block;

padding:5px 14px;

border-radius:20px;

background:#FFE5F0;

font-size:13px;

margin-bottom:6px;

}



.record-info h3{

font-size:22px;

margin-bottom:4px;

}



.record-info p{

color:#888;

font-size:15px;

}



.record-meta{

text-align:right;

display:flex;

flex-direction:column;

gap:8px;

font-size:14px;

color:#999;

}



.record-meta time{

font-weight:600;

color:#777;

}



.philosophy-grid{

display:grid;

grid-template-columns:repeat(3,1fr);

gap:30px;

}



.philosophy-card{

background:rgba(255,255,255,0.7);

backdrop-filter:blur(15px);

padding:35px;

border-radius:35px;

text-align:center;

box-shadow:0 15px 40px rgba(0,0,0,.06);

transition:.3s;

}



.philosophy-card:hover{

transform:translateY(-8px);

}



.philosophy-card .icon{

font-size:50px;

display:block;

margin-bottom:15px;

}



.philosophy-card h3{

font-size:26px;

margin-bottom:10px;

}



.philosophy-card p{

color:#777;

line-height:1.7;

}



@media(max-width:900px){

.stats,
.chart-grid,
.philosophy-grid{

grid-template-columns:1fr;

}



.today-card,
.record{

flex-direction:column;

gap:15px;

text-align:center;

}



.record-meta{

text-align:center;

flex-direction:row;

justify-content:center;

}

}


</style>
