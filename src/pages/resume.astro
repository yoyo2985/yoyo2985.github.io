---
import MainLayout from "../layouts/MainLayout.astro";
import { ArrowDownToLine, ArrowUpRight } from "@lucide/astro";
const projects = [
  ["/projects/lung-cancer-lm-prediction","肺癌脑膜转移预测系统","项目负责人 · 国家级项目 · 国创赛金奖"],
  ["/projects/lstm-aero-engine-rul","航空发动机剩余寿命预测","第一主持人 · 国豪论坛学术汇报"],
  ["/projects/3d-printing-ml","3D 打印质量研究与参数优化","核心成员 · 上海市创新创业项目"],
  ["/projects/smart-veggie-packaging","叶菜洁净包装一体化机器","机械设计 · 上海市二等奖"],
];
---
<MainLayout title="简历 · Yoyo" description="Yoyo 的教育、研究经历、荣誉与技能。">
  <header class="cv-hero section-shell">
    <div><span class="eyebrow">CURRICULUM VITAE / 2026</span><h1>Yoyo</h1><p>智能制造工程本科生 · AI 研究者 · 工程实践者</p></div>
    <div class="cv-actions"><a class="button-primary" href="/resume/Yoyo_CV.pdf" download onclick="gtag('event', 'download_cv')">下载 PDF <ArrowDownToLine size={18} /></a><a class="button-secondary" href="/research">项目档案 <ArrowUpRight size={18} /></a></div>
  </header>

  <div class="cv-layout section-shell">
    <aside class="cv-aside">
      <section><span class="aside-label">PROFILE</span><p>同济大学机械工程与机器人学院，智能制造工程专业，关注医学影像 AI、时序预测与具身智能。</p></section>
      <section><span class="aside-label">SKILLS</span><div class="skill-cloud"><span>Python</span><span>PyTorch</span><span>Deep Learning</span><span>Medical Imaging</span><span>Transformer</span><span>Computer Vision</span><span>SolidWorks</span><span>MATLAB</span></div></section>
      <section><span class="aside-label">LINKS</span><a href="https://github.com/yoyo2985" target="_blank" rel="noopener">github.com/yoyo2985 <ArrowUpRight size={14} /></a></section>
    </aside>

    <div class="cv-main">
      <section class="cv-section" data-reveal><div class="section-no">01</div><div><span class="aside-label">EDUCATION</span><article class="cv-entry"><div><h2>同济大学</h2><p>机械工程与机器人学院 · 智能制造工程</p></div><time>2024—NOW</time></article><ul class="detail-list"><li>四学期绩点：5.0 / 5.0 / 4.88 / 4.78</li><li>智能制造类专业排名第一</li><li>2024—2025、2025—2026 学年国家奖学金</li></ul></div></section>

      <section class="cv-section" data-reveal><div class="section-no">02</div><div><span class="aside-label">RESEARCH & PROJECTS</span><div class="project-links">{projects.map(([href,title,meta]) => <a href={href}><div><h3>{title}</h3><p>{meta}</p></div><ArrowUpRight size={20} /></a>)}</div></div></section>

      <section class="cv-section" data-reveal><div class="section-no">03</div><div><span class="aside-label">AWARDS</span><div class="award-list"><article><time>2025</time><h3>国家奖学金</h3><p>2024—2025 学年度</p></article><article><time>2026</time><h3>国家奖学金</h3><p>2025—2026 学年度</p></article><article><time>2025</time><h3>中国大学生数学竞赛</h3><p>非数学 A 类 · 上海市一等奖</p></article><article><time>2025</time><h3>国际工程力学奥林匹克竞赛</h3><p>个人二等奖 · 团体三等奖</p></article><article><time>2025</time><h3>上海机械工程创新设计大赛</h3><p>上海市二等奖</p></article><article><time>2026</time><h3>国创赛校内选拔赛金奖</h3><p>国家级项目</p></article></div></div></section>

      <section class="cv-section" data-reveal><div class="section-no">04</div><div><span class="aside-label">OTHER EXPERIENCE</span><div class="experience-grid"><article><h3>具身智能机器人系统</h3><p>关注机器人感知、控制与智能系统融合。</p></article><article><h3>同济大学人形机器人战队</h3><p>机械组 · 参与结构设计与系统实践。</p></article><article><h3>外研社国才杯</h3><p>英语综合能力竞赛 · 银奖。</p></article></div></div></section>
    </div>
  </div>
</MainLayout>

<style>
  .cv-hero{display:flex;justify-content:space-between;align-items:end;gap:35px;padding-top:165px;padding-bottom:70px;border-bottom:1px solid var(--line)}.cv-hero h1{margin:10px 0 0;font:800 clamp(80px,14vw,190px)/.8 var(--display);letter-spacing:-.085em}.cv-hero p{margin:30px 0 0;color:var(--muted);font-size:18px}.cv-actions{display:flex;gap:10px;flex-wrap:wrap}.cv-layout{display:grid;grid-template-columns:260px minmax(0,1fr);gap:clamp(45px,8vw,110px);padding-top:70px;padding-bottom:120px}.cv-aside{position:sticky;top:110px;align-self:start}.cv-aside section{padding:0 0 25px;margin-bottom:25px;border-bottom:1px solid var(--line)}.aside-label{display:block;margin-bottom:13px;color:var(--acid);font:600 10px/1 var(--mono);letter-spacing:.14em}.cv-aside p{margin:0;color:var(--muted);font-size:14px}.skill-cloud{display:flex;flex-wrap:wrap;gap:6px}.skill-cloud span{padding:6px 8px;border:1px solid var(--line);border-radius:6px;color:var(--muted);font:500 9px var(--mono)}.cv-aside a{display:flex;align-items:center;gap:7px;color:var(--ink);text-decoration:none;font-size:13px}.cv-aside a:hover{color:var(--acid)}.cv-section{display:grid;grid-template-columns:45px 1fr;gap:22px;padding:0 0 75px;margin-bottom:70px;border-bottom:1px solid var(--line)}.section-no{color:var(--muted);font:600 10px var(--mono)}.cv-entry{display:flex;justify-content:space-between;gap:30px;margin-top:25px}.cv-entry h2{margin:0;font:720 40px/1 var(--display);letter-spacing:-.04em}.cv-entry p{margin:9px 0 0;color:var(--muted)}.cv-entry time,.award-list time{color:var(--cyan);font:600 10px var(--mono)}.detail-list{margin:30px 0 0;padding:0;list-style:none}.detail-list li{padding:11px 0;border-top:1px solid var(--line);color:var(--muted)}.detail-list li::before{content:"+";display:inline-block;width:24px;color:var(--acid);font-family:var(--mono)}.project-links{margin-top:20px;border-top:1px solid var(--line)}.project-links a{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:22px 0;border-bottom:1px solid var(--line);text-decoration:none}.project-links h3{margin:0;font-size:18px}.project-links p{margin:4px 0 0;color:var(--muted);font-size:13px}.project-links svg{color:var(--acid);transition:.25s var(--ease)}.project-links a:hover svg{transform:translate(4px,-4px)}.award-list{border-top:1px solid var(--line)}.award-list article{display:grid;grid-template-columns:70px 1fr 1fr;gap:15px;align-items:center;padding:17px 0;border-bottom:1px solid var(--line)}.award-list h3,.award-list p{margin:0}.award-list h3{font-size:15px}.award-list p{color:var(--muted);font-size:13px}.experience-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:22px}.experience-grid article{padding:20px;border:1px solid var(--line);border-radius:12px}.experience-grid h3{margin:0;font-size:15px}.experience-grid p{margin:10px 0 0;color:var(--muted);font-size:13px}
  @media(max-width:800px){.cv-hero{display:block;padding-top:125px}.cv-actions{margin-top:30px}.cv-layout{grid-template-columns:1fr}.cv-aside{position:static;display:grid;grid-template-columns:repeat(2,1fr);gap:25px}.cv-section{grid-template-columns:30px 1fr}.experience-grid{grid-template-columns:1fr}}@media(max-width:520px){.cv-aside{grid-template-columns:1fr}.cv-entry{display:block}.cv-entry time{display:block;margin-top:10px}.award-list article{grid-template-columns:50px 1fr}.award-list p{grid-column:2}.cv-section{gap:10px}.cv-actions a{width:100%}}
  @media(min-width:801px){.cv-layout{grid-template-columns:280px minmax(0,1fr)}}
  .cv-aside p{font-size:16px;line-height:1.75}.cv-aside .aside-label{font-size:11px}.skill-cloud{gap:7px}.skill-cloud span{padding:7px 9px;font-size:11px}.cv-aside a{font-size:15px}
</style>
