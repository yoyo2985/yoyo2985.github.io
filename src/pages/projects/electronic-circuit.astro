---
import MainLayout from "../../layouts/MainLayout.astro";
import { ArrowUpRight, CircuitBoard } from "@lucide/astro";
const repo = "https://github.com/yoyo2985/electronic-circuit";
const layers = [
  ["01 / PERCEPTION", "语音感知", "ES8388 音频采集 → I2S / PCM → VAD → 13 维 MFCC 特征。"],
  ["02 / COGNITION", "身份与指令", "声纹模板验证属主身份，有限词表匹配停止、左转、右转与前进指令。"],
  ["03 / CONTROL", "闭环运动控制", "状态机 → 轨迹限速 → 定点 PID → 虚拟电机与编码器反馈。"],
  ["04 / DIGITAL TWIN", "实时状态映射", "UART 遥测 → Web Serial → 机器人姿态、状态机、曲线与故障日志。"],
];
---
<MainLayout title="FPGA 语音机器人闭环控制 · Yoyo" description="基于安路 EG4S20 的 FPGA 实时感知、决策与闭环运动控制平台，包含语音交互原型和 Web 数字孪生演示。">
  <article class="case section-shell">
    <a class="back" href="/research">← 返回项目索引</a>
    <header>
      <span class="eyebrow">FPGA × ROBOTICS / 2026</span>
      <CircuitBoard size={44} strokeWidth={1.25} />
      <h1>从语音输入，<br />到<span>闭环控制。</span></h1>
      <p class="subtitle">FPGA Voice Robot & Digital Twin</p>
      <p class="intro">在安路 EG4S20 开发板上，把语音感知、身份验证、指令理解和运动控制串成实时硬件闭环，再通过浏览器数字孪生观察系统反馈。</p>
      <div class="actions">
        <a href="/electronic-circuit/index.html" data-astro-reload>体验数字孪生 <ArrowUpRight size={18} /></a>
        <a href={repo} target="_blank" rel="noopener noreferrer">查看 GitHub 源码 <ArrowUpRight size={18} /></a>
        <a href={`${repo}/blob/main/report.pdf`} target="_blank" rel="noopener noreferrer">课程报告 <ArrowUpRight size={18} /></a>
      </div>
    </header>
    <section class="overview">
      <span class="eyebrow">PROJECT OVERVIEW</span><h2>真实控制器，虚拟执行对象。</h2>
      <p>FPGA 承担实时信号处理与控制计算；执行对象使用 FPGA 内部的一阶虚拟电机和编码器反馈模型。PC 端通过 UART 接收目标、位置和状态，用 SVG 机器人与实时曲线呈现运动过程。</p>
      <p>键盘与语音输入复用同一条运动控制链。工程使用 Verilog HDL、TangDynasty 和 ModelSim，Python 用于参考模型、工具与离线验证。</p>
    </section>
    <section><span class="eyebrow">SYSTEM ARCHITECTURE</span><h2>四层架构，一条反馈闭环。</h2><div class="layers">{layers.map(([index,title,desc]) => <div><small>{index}</small><h3>{title}</h3><p>{desc}</p></div>)}</div></section>
    <section><span class="eyebrow">IMPLEMENTATION</span><h2>把资源留给实时处理。</h2>
      <dl class="metrics"><div><dt>6,440 / 19,600</dt><dd>LUT 占用约 32.9%</dd></div><div><dt>28 / 29</dt><dd>DSP 占用</dd></div><div><dt>4</dt><dd>BRAM 使用</dd></div></dl>
      <p>仓库记录的板上综合结果显示，FFT 缓存由寄存器阵列改为 BRAM IP 后，FFT 部分 LUT 从约 11,620 降至约 375。音频采集与统一语音运动顶层已完成板上链路验证。</p>
    </section>
    <section><span class="eyebrow">TRY THE SYSTEM</span><h2>无需开发板，也能体验。</h2>
      <p>数字孪生控制台提供 Demo Mode，可观察目标变化、轨迹限速和位置反馈；Live FPGA Mode 可通过 Web Serial 连接正在发送遥测的开发板。实时连接请使用支持 Web Serial 的 Chrome 或 Edge。</p>
      <a class="demo-link" href="/electronic-circuit/index.html" data-astro-reload>打开数字孪生控制台 →</a>
    </section>
    <section class="limits"><span class="eyebrow">VALIDATION & LIMITS</span><h2>验证结果与边界。</h2>
      <p>语音链采用轻量级 MFCC + L1 模板匹配。仓库记录的属主命令词实测命中率为 22/35（约 63%），左转与右转存在混淆；它是验证实时闭环架构的原型。</p>
      <p>整机演示关闭了低速下易误判的自动堵转检测，故障演示通过 SW2 手动触发。数字孪生使用简化动力学模型；Demo 的模拟结果与 Live 的板上数据分别展示。</p>
      <p>详细测试记录、资源占用和复现说明见 <a href={`${repo}#readme`} target="_blank" rel="noopener noreferrer">项目 README</a>。原始语音数据已按隐私要求删除，部分离线评估需重新采集数据后复现。</p>
    </section>
  </article>
</MainLayout>
<style>
  .case{padding-top:130px;padding-bottom:100px;max-width:1200px}.back{color:var(--muted);font-size:13px;text-decoration:none}header{padding:52px 0 64px;position:relative}header>svg{display:block;margin-top:25px;color:var(--cyan)}h1{font:760 clamp(46px,7vw,92px)/1.05 var(--display);letter-spacing:-.055em;margin:25px 0 15px}h1 span{color:var(--acid)}.subtitle{font:500 12px var(--mono);color:var(--cyan)}.intro{max-width:780px;font-size:19px;color:var(--muted);margin:26px 0}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}.actions a,.demo-link{display:inline-flex;align-items:center;gap:10px;border:1px solid var(--line);border-radius:10px;padding:12px 18px;text-decoration:none;color:var(--acid)}.actions a:hover,.demo-link:hover{background:var(--hover)}section{border-top:1px solid var(--line);padding:42px 0}h2{font:700 clamp(27px,4vw,42px)/1.2 var(--display);letter-spacing:-.035em;margin:14px 0 24px}section>p{max-width:850px;color:var(--muted)}.layers{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.layers>div{padding:24px;border:1px solid var(--line);border-radius:14px;background:var(--surface)}.layers small{font:500 10px var(--mono);color:var(--cyan)}.layers h3{margin:15px 0 10px;font-size:23px}.layers p{color:var(--muted);margin:0;font-size:14px}.metrics{display:grid;grid-template-columns:2fr 1fr 1fr;gap:20px;margin:30px 0}.metrics dt{font:700 clamp(24px,3vw,38px) var(--display);color:var(--acid)}.metrics dd{margin:6px 0;color:var(--muted);font-size:13px}.limits a{color:var(--cyan)}@media(max-width:600px){.case{padding-top:110px}header{padding-top:35px}.layers,.metrics{grid-template-columns:1fr}.intro{font-size:16px}.actions{flex-direction:column;align-items:flex-start}section{padding:32px 0}}
</style>
