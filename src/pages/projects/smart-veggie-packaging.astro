<style>
.project-page{
padding:140px 10% 80px;
background: linear-gradient(180deg, #F0FFF4 0%, #E6FFFA 100%);
}

.back-link{
display:inline-block;
margin-bottom:40px;
padding:12px 28px;
border-radius:30px;
background:rgba(255,255,255,0.65);
backdrop-filter:blur(20px);
box-shadow:0 8px 24px rgba(0,0,0,.06);
text-decoration:none;
color:#555;
transition:.3s;
font-size:15px;
}
.back-link:hover{
transform:translateX(-5px);
box-shadow:0 12px 30px rgba(0,0,0,.1);
}

.hero{
text-align:center;
margin-bottom:70px;
}
.hero-icon{
font-size:90px;
margin-bottom:20px;
}
.hero h1{
font-size:52px;
line-height:1.3;
margin-bottom:15px;
}
.hero p{
font-size:22px;
color:#777;
}

.card{
margin-bottom:35px;
padding:40px;
border-radius:35px;
background:rgba(255,255,255,0.65);
backdrop-filter:blur(20px);
box-shadow:0 15px 40px rgba(0,0,0,.08);
}
.card h2{
font-size:30px;
margin-bottom:20px;
}
.card p{
font-size:17px;
line-height:1.8;
color:#444;
}

.card ul{
list-style:none;
padding:0;
margin:0;
}
.card ul li{
padding:12px 0 12px 25px;
position:relative;
font-size:16px;
line-height:1.7;
color:#444;
border-bottom:1px solid rgba(0,0,0,0.05);
}
.card ul li:last-child{
border-bottom:none;
}
.card ul li::before{
content:"✦";
position:absolute;
left:0;
color:#5FBF8E;
}

.pipeline{
display:flex;
justify-content:center;
align-items:center;
gap:12px;
