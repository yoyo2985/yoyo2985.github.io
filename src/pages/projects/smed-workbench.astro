---
import MainLayout from "../../layouts/MainLayout.astro";
import { ArrowUpRight, Cog } from "@lucide/astro";
const repo = "https://github.com/yoyo2985/smed-workbench";
const stages = [
  ["01 / OBSERVE", "先定义换型", "从上一批最后良品完成，到下一产品首件批准放行，保留每个动作的时间和资源。"],
  ["02 / IMPROVE", "再安排准备", "区分内外部作业，减少寻找与反复，关注基准、程序、夹具和首件反馈。"],
  ["03 / SIMULATE", "比较资源约束", "在同一组订单下，观察人员、准备站、检测容量、在制上限与工序先后。"],
  ["04 / VERIFY", "回到现场验证", "以同类换型复测、首件质量与测量能力验证，校准参数后再交给生产计划。"],
];
---
<MainLayout title="机床 SMED 与排产仿真 · Yoyo" description="机床快速换型、首件放行与有限资源仿真工作台。公开版采用完全合成数据，连接现场改善、生产计划与布局验证。">
  <article class="case section-shell">
    <a class="back" href="/research">← 返回项目索引</a>
    <header>
      <span class="eyebrow">SMED × FMS × HUMAN FACTORS / 2026</span>
      <Cog size={44} strokeWidth={1.25} />
      <h1>把换型改善，<br />连接到<span>生产计划。</span></h1>
      <p class="subtitle">SMED & FMS Scenario Workbench</p>
      <p class="intro">我主要负责机床 SMED：把刀具、工装、找正、试切与首件批准串成可观察的过程，再将换型时间和准备资源交给生产计划与未来布局分析。</p>
      <div class="actions"><a href="/smed/index.html" data-astro-reload>打开交互工作台 <ArrowUpRight size={18} /></a><a href={repo} target="_blank" rel="noopener noreferrer">GitHub 源码 <ArrowUpRight size={18} /></a><a href="https://yoyo2985.github.io/smed-workbench/" target="_blank" rel="noopener noreferrer">独立演示站 <ArrowUpRight size={18} /></a></div>
    </header>
    <section><span class="eyebrow">MY ROLE</span><h2>关注机床停下之后，也关注停下之前。</h2><p>工作重点包括换型边界与记录口径、内外部作业分离、首件反复原因、共享调试员与准备站，以及标准作业和换型参数的交接。人因观察关注寻找、搬运、弯腰、探身与辨识负担，避免仅依靠加快动作取得表面改善。</p></section>
    <section><span class="eyebrow">WORKFLOW</span><h2>从动作到订单，保留中间的约束。</h2><div class="layers">{stages.map(([index,title,desc]) => <div><small>{index}</small><h3>{title}</h3><p>{desc}</p></div>)}</div></section>
    <section><span class="eyebrow">INTERACTIVE PROTOTYPE</span><h2>用情景比较，检验直觉。</h2><p>工作台提供四种安排：假设现状、SMED、同配置优先与在制释放，以及准备支持和运输改变。机床、调试员、准备站、转运和首件检测共享有限资源；在制减少时，也同时检查投放前等待与订单完成时间。</p><dl class="metrics"><div><dt>32</dt><dd>完全合成订单</dd></div><div><dt>4</dt><dd>对比情景</dd></div><div><dt>8周</dt><dd>通用执行安排</dd></div></dl><p>此外包含配对重复、参数敏感性、设备时间线、现场事件与动作采集，以及在浏览器本地保存和主动导出备份。</p><a class="demo-link" href="/smed/index.html" data-astro-reload>打开 SMED 工作台 →</a></section>
    <section class="limits"><span class="eyebrow">VALIDATION & BOUNDARIES</span><h2>把公开方法与现场结论分开。</h2><p>公开版的订单、客户、设备、历史记录及动作分项均完全合成，不包含企业原始资料。演示参数与结果不用于真实工单下发或交期承诺。</p><p>原型已验证资源无重叠、工序先后、数量守恒、在制上限和固定种子复现。真实实施仍需现场测时、工艺适配、库存分配与质量认可；布局目前只比较资源支持方式，未给出真实车间尺寸方案。</p><p>源码、复现方式与现场校准清单见 <a href={`${repo}#readme`} target="_blank" rel="noopener noreferrer">项目 README</a>。</p></section>
  </article>
</MainLayout>
<style>
.case{padding-top:130px;padding-bottom:100px;max-width:1200px}.back{color:var(--muted);font-size:13px;text-decoration:none}header{padding:52px 0 64px}header>svg{display:block;margin-top:25px;color:var(--cyan)}h1{font:760 clamp(42px,7vw,88px)/1.08 var(--display);letter-spacing:-.055em;margin:25px 0 15px}h1 span{color:var(--acid)}.subtitle{font:500 12px var(--mono);color:var(--cyan)}.intro{max-width:800px;font-size:19px;color:var(--muted);margin:26px 0}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}.actions a,.demo-link{display:inline-flex;align-items:center;gap:10px;border:1px solid var(--line);border-radius:10px;padding:12px 18px;text-decoration:none;color:var(--acid)}.actions a:first-child{background:var(--acid);color:var(--bg)}.actions a:hover,.demo-link:hover{transform:translateY(-2px)}section{border-top:1px solid var(--line);padding:42px 0}h2{font:700 clamp(27px,4vw,42px)/1.2 var(--display);letter-spacing:-.035em;margin:14px 0 24px}section>p{max-width:850px;color:var(--muted)}.layers{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.layers>div{padding:24px;border:1px solid var(--line);border-radius:14px;background:var(--surface)}.layers small{font:500 10px var(--mono);color:var(--cyan)}.layers h3{margin:15px 0 10px;font-size:23px}.layers p{color:var(--muted);margin:0;font-size:14px}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin:30px 0}.metrics dt{font:700 clamp(25px,3vw,40px) var(--display);color:var(--acid)}.metrics dd{margin:6px 0;color:var(--muted);font-size:13px}.limits a{color:var(--cyan)}@media(max-width:600px){.case{padding-top:110px}header{padding-top:35px}.layers,.metrics{grid-template-columns:1fr}.intro{font-size:16px}.actions{flex-direction:column;align-items:flex-start}section{padding:32px 0}}
</style>
