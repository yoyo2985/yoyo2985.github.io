</MainLayout>

<style>
.project-page{
padding:140px 10% 80px;
background: linear-gradient(180deg, #FFF9F5 0%, #F0F5FF 100%);
}

.back-link{
display:inline-block;
margin-bottom:40px;
padding:12px 28px;
border-radius:30px;
background:rgba(255,255,255,0.65);
backdrop-filter:blur(20px);
box-shadow:0 8px 24px rgba(0,0,0,.06);
text-decoration:none;
color:#555;
transition:.3s;
font-size:15px;
}
.back-link:hover{
transform:translateX(-5px);
box-shadow:0 12px 30px rgba(0,0,0,.1);
}

.hero{
text-align:center;
margin-bottom:70px;
}
.hero-icon{
font-size:90px;
margin-bottom:20px;
}
.hero h1{
font-size:52px;
line-height:1.3;
margin-bottom:15px;
}
.hero p{
font-size:22px;
color:#777;
}

.card{
margin-bottom:35px;
padding:40px;
border-radius:35px;
background:rgba(255,255,255,0.65);
backdrop-filter:blur(20px);
box-shadow:0 15px 40px rgba(0,0,0,.08);
}
.card h2{
font-size:30px;
margin-bottom:20px;
}
.card p{
font-size:17px;
line-height:1.8;
color:#444;
}

.role-intro{
font-weight:500;
margin-bottom:15px !important;
}

.card ul{
list-style:none;
padding:0;
margin:0;
}
.card ul li{
padding:12px 0 12px 25px;
position:relative;
font-size:16px;
line-height:1.7;
color:#444;
border-bottom:1px solid rgba(0,0,0,0.05);
}
.card ul li:last-child{
border-bottom:none;
}
.card ul li::before{
content:"✦";
position:absolute;
left:0;
color:#ab9ec4;
}

.pipeline{
display:flex;
justify-content:center;
align-items:center;
gap:12px;
flex-wrap:wrap;
margin:20px 0 25px;
font-size:17px;
}
.pipeline div{
padding:12px 24px;
background:#E4EEFF;
border-radius:25px;
color:#555;
font-weight:500;
}
.pipeline span{
color:#ab9ec4;
font-weight:bold;
}

.tags{
display:flex;
flex-wrap:wrap;
gap:12px;
margin-top:15px;
}
.tags span{
padding:8px 20px;
background:#FFE4F0;
border-radius:25px;
font-size:14px;
color:#666;
}

.github-btn{
display:inline-block;
margin-top:15px;
padding:14px 32px;
border-radius:35px;
background:#333;
color:white !important;
text-decoration:none;
font-size:16px;
font-weight:500;
transition:.3s;
box-shadow:0 8px 25px rgba(0,0,0,.12);
}
.github-btn:hover{
transform:translateY(-4px);
box-shadow:0 12px 35px rgba(0,0,0,.2);
background:#222;
}

@media(max-width:768px){
.hero h1{font-size:36px;}
.hero p{font-size:18px;}
.card{padding:30px 25px;}
.card h2{font-size:24px;}
.pipeline{font-size:15px;}
.pipeline div{padding:10px 18px;}
}
</style>