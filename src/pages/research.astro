---
import MainLayout from "../layouts/MainLayout.astro";
import { ArrowUpRight, BrainCircuit, ChartNoAxesCombined, CircuitBoard, Cog, Leaf, Printer, Sigma } from "@lucide/astro";
const projects = [
  {href:"/projects/turning-geometry",category:"engineering",number:"09",year:"2026",title:"刀具几何实验室",en:"Cutting Geometry Lab",desc:"用参数化三维模型展示刀具角度、切削刃与参考平面的关系，支持标准剖面观察和离线教学。",role:"几何建模与交互开发",result:"课程交互演示",tags:["Blender","Three.js","Manufacturing"],Icon:Cog},
  {href:"/projects/lung-cancer-lm-prediction",category:"ai",number:"01",year:"2026",title:"肺癌脑膜转移预测",en:"MRI-based LM Prediction",desc:"以头部 MRI 为核心，探索 CNN、Transformer 与多模态信息融合的临床预测系统。",role:"项目负责人",result:"国家级项目 · 金奖",tags:["MRI","PyTorch","Transformer"],Icon:BrainCircuit},
  {href:"/projects/lstm-aero-engine-rul",category:"ai",number:"02",year:"2025",title:"航空发动机剩余寿命预测",en:"Aero-engine RUL Prediction",desc:"面向复杂退化序列，以 LSTM 和注意力机制构建可验证的剩余寿命预测框架。",role:"第一主持人",result:"国豪论坛汇报",tags:["LSTM","C-MAPSS","Time Series"],Icon:ChartNoAxesCombined},
  {href:"/projects/3d-printing-ml",category:"ai",number:"03",year:"2025",title:"3D 打印质量与参数优化",en:"ML for Additive Manufacturing",desc:"把物理信息与机器学习带入增材制造质量控制，连接参数、过程与成型结果。",role:"核心成员",result:"上海市创新项目",tags:["PINN","ML","Additive Manufacturing"],Icon:Printer},
  {href:"/projects/gearbox-design",category:"engineering",number:"04",year:"2026",title:"减速箱系统设计",en:"Gearbox System Design",desc:"覆盖设计计算、三维结构、二维工程图和装配演示的机械设计完整闭环。",role:"独立设计",result:"课程项目",tags:["SolidWorks","CAD","Mechanics"],Icon:Cog},
  {href:"/projects/smart-veggie-packaging",category:"engineering",number:"05",year:"2025",title:"叶菜洁净包装一体机",en:"Smart Veggie Packaging",desc:"围绕清洗、沥干、包装三道工序，完成自动化设备的结构与传动设计。",role:"机械设计",result:"上海市二等奖",tags:["Prototyping","Transmission","Food Safety"],Icon:Leaf},
  {href:"/projects/shuweibei-mathmodel",category:"modeling",number:"06",year:"2026",title:"数维杯数学建模",en:"Shuwei Cup Modeling",desc:"从问题假设、数据分析、优化算法到论文表达的高强度协作实践。",role:"建模与编程",result:"竞赛项目",tags:["Python","MATLAB","Optimization"],Icon:Sigma},
  {href:"/projects/electronic-circuit",category:"engineering",number:"07",year:"2026",title:"FPGA 语音机器人闭环控制",en:"FPGA Voice Robot & Digital Twin",desc:"在 EG4S20 上串联语音感知、声纹验证、指令决策与 PID 运动控制，并通过 Web 数字孪生观察执行反馈。",role:"项目开发",result:"板上链路验证",tags:["Verilog","FPGA","Digital Twin"],Icon:CircuitBoard},
  {href:"/projects/smed-workbench",category:"engineering",number:"08",year:"2026",title:"机床 SMED 与排产仿真",en:"SMED & FMS Scenario Workbench",desc:"连接快速换型、首件放行与有限资源仿真，探索准备资源、在制释放和生产计划的关系。",role:"机床 SMED / 方法与仿真",result:"开源交互工作台",tags:["SMED","FMS","Simulation"],Icon:Cog},
];
---
<MainLayout title="研究项目 · Yoyo" description="Yoyo 的研究与工程项目索引，涵盖医学 AI、深度学习、智能制造与机械设计。">
  <header class="work-hero section-shell">
    <div><span class="eyebrow">PROJECT ARCHIVE / 2024—NOW</span><h1>这些项目，<br />记录了我在<span>做什么。</span></h1></div>
    <p>从医学影像到机械结构，我把项目背景、自己的分工、采用的方法和已有结果整理在了这里。</p>
  </header>

  <section class="archive section-shell">
    <div class="archive-tools" data-project-filters>
      <div class="filters" role="group" aria-label="项目分类筛选">
        <button class="active" data-filter="all">全部 <span>09</span></button>
        <button data-filter="ai">AI 研究 <span>03</span></button>
        <button data-filter="engineering">工程设计 <span>05</span></button>
        <button data-filter="modeling">建模 <span>01</span></button>
      </div>
      <span class="archive-note">SELECT A PROJECT TO OPEN CASE STUDY</span>
    </div>
    <div class="archive-list" data-project-list>
      {projects.map(({href,category,number,year,title,en,desc,role,result,tags,Icon}) => (
        <a class="archive-item" href={href} data-category={category} data-reveal>
          <div class="item-index"><span>{number}</span><small>{year}</small></div>
          <div class="item-icon"><Icon size={30} strokeWidth={1.45} /></div>
          <div class="item-main"><span class="item-category">{category === "ai" ? "AI RESEARCH" : category === "engineering" ? "ENGINEERING" : "MODELING"}</span><h2>{title}</h2><p class="en-title">{en}</p><p>{desc}</p><div class="item-tags">{tags.map(tag => <span>{tag}</span>)}</div></div>
          <div class="item-meta"><dl><div><dt>ROLE</dt><dd>{role}</dd></div><div><dt>RESULT</dt><dd>{result}</dd></div></dl><ArrowUpRight size={28} /></div>
        </a>
      ))}
    </div>
  </section>
</MainLayout>

<script is:inline>
  const setupFilters = () => {
    const toolbar = document.querySelector('[data-project-filters]');
    const items = document.querySelectorAll('[data-project-list] .archive-item');
    if (!toolbar || !items.length || toolbar.dataset.initialized === 'true') return;
    toolbar.dataset.initialized = 'true';
    toolbar.querySelectorAll('[data-filter]').forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter;
        toolbar.querySelectorAll('[data-filter]').forEach((item) => item.classList.toggle('active', item === button));
        items.forEach((item) => item.toggleAttribute('hidden', filter !== 'all' && item.dataset.category !== filter));
      });
    });
  };
  setupFilters();
  document.addEventListener('astro:page-load', setupFilters);
</script>

<style>
  .work-hero{display:grid;grid-template-columns:1.2fr .55fr;gap:60px;align-items:end;padding-top:170px;padding-bottom:95px}.work-hero h1{margin:18px 0 0;font:780 clamp(52px,8vw,112px)/.89 var(--display);letter-spacing:-.075em}.work-hero h1 span{color:var(--acid)}.work-hero>p{margin:0 0 9px;color:var(--muted);font-size:18px;line-height:1.8}.archive{padding-bottom:120px}.archive-tools{position:sticky;z-index:20;top:96px;display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:18px;padding:12px;border:1px solid var(--line);border-radius:14px;background:rgba(7,17,15,.9);backdrop-filter:blur(16px)}.filters{display:flex;gap:5px;flex-wrap:wrap}.filters button{padding:9px 12px;border:0;border-radius:9px;background:transparent;color:var(--muted);font-size:13px;cursor:pointer}.filters button span{margin-left:6px;font:500 9px var(--mono);opacity:.65}.filters button:hover,.filters button.active{background:var(--acid);color:var(--bg)}.archive-note{margin-right:6px;color:var(--muted);font:500 9px var(--mono);letter-spacing:.1em}.archive-list{border-top:1px solid var(--line)}.archive-item{display:grid;grid-template-columns:64px 64px minmax(0,1fr) 190px;gap:24px;padding:34px 12px;border-bottom:1px solid var(--line);color:var(--ink);text-decoration:none;transition:.3s var(--ease)}.archive-item[hidden]{display:none}.archive-item:hover{background:rgba(255,255,255,.025);padding-left:22px;padding-right:22px}.item-index{display:flex;flex-direction:column;gap:5px}.item-index span{font:650 12px var(--mono);color:var(--acid)}.item-index small{font:500 9px var(--mono);color:var(--muted)}.item-icon{display:grid;place-items:center;width:54px;height:54px;border:1px solid var(--line);border-radius:15px;color:var(--cyan)}.item-category{font:600 9px var(--mono);letter-spacing:.13em;color:var(--cyan)}.item-main h2{margin:7px 0 0;font:700 clamp(27px,3.3vw,46px)/1.05 var(--display);letter-spacing:-.045em}.en-title{margin:5px 0 14px!important;color:var(--acid)!important;font:500 11px/1.4 var(--mono)!important;text-transform:uppercase}.item-main>p{max-width:690px;margin:0;color:var(--muted);font-size:14px}.item-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:17px}.item-tags span{padding:5px 7px;border:1px solid var(--line);border-radius:6px;color:var(--muted);font:500 9px var(--mono)}.item-meta{display:flex;flex-direction:column;justify-content:space-between;align-items:flex-end}.item-meta dl{width:100%;margin:0}.item-meta dl div{margin-bottom:13px}.item-meta dt{font:600 8px var(--mono);color:var(--muted);letter-spacing:.12em}.item-meta dd{margin:2px 0 0;font-size:12px}.item-meta>svg{color:var(--acid);transition:.3s var(--ease)}.archive-item:hover .item-meta>svg{transform:translate(5px,-5px)}
  @media(max-width:900px){.work-hero{grid-template-columns:1fr;gap:25px;padding-top:130px}.archive-item{grid-template-columns:48px minmax(0,1fr) 130px}.item-icon{display:none}.archive-note{display:none}}@media(max-width:620px){.work-hero{padding-bottom:60px}.archive-tools{top:80px;overflow:auto}.filters{flex-wrap:nowrap}.filters button{white-space:nowrap}.archive-item{grid-template-columns:38px 1fr;gap:12px;padding:26px 4px}.item-meta{grid-column:2;flex-direction:row;align-items:end}.item-meta dl{display:flex;gap:22px}.item-meta dl div{margin:0}.item-meta>svg{display:none}.item-main h2{font-size:29px}}
  .work-hero h1{font-size:clamp(52px,7.5vw,104px)}
  .work-hero h1 span{white-space:nowrap}
</style>
